{
  "manifest_version": 3,
  "name": "GitLurk Desktop Bridge",
  "version": "0.1.5",
  "description": "Adds Open with GitLurk Desktop to GitHub clone UI",
  "host_permissions": ["https://github.com/*"],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*"],
      "js": ["dist/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon48.png"
  }
}
