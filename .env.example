# Copy to `.env` in the repo root (never commit `.env`).
# Device Flow only needs GITHUB_CLIENT_ID; the secret is optional and stays in the Rust backend.
# Aliases: GITLURK_GITHUB_* or legacy MYGIT_GITHUB_* (see docs/security.md).

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1/callback

# Release signing (Tauri updater). The keypair lives OUTSIDE the repo, e.g.
# %USERPROFILE%\.tauri\gitlurk.key (+ .pub, + .password). Move both private key
# and password into secure storage; if either is lost, signed updates break.
# TAURI_SIGNING_PRIVATE_KEY_PATH=C:\Users\you\.tauri\gitlurk.key
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
